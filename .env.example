# ===== 必須の環境変数 =====

# Claude API キー（クイズ生成に使用）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TikTok Content Posting API
# https://developers.tiktok.com/ でアプリ登録後に取得
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_OPEN_ID=your_tiktok_open_id_here

# ===== オプション =====

# DRY_RUN=true にすると動画生成のみ（TikTok投稿しない）
# DRY_RUN=true

# カテゴリを固定したい場合（空だと日付で自動ローテーション）
# CATEGORY_OVERRIDE=🌏 地理
